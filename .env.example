# Server
PORT=5001
CORS_ORIGINS=http://localhost:5173,http://localhost:5001

# Vite frontend build only; set to deployed backend origin in Vercel Production.
# Leave unset for same-origin local development.
# VITE_API_BASE=https://your-api-host.example

# Inference mode: defaults to ML-required. Set to rule-based only for an explicitly
# labeled heuristic estimate, never to claim an ML model prediction.
PREDICTION_MODE=ml
# Number of trusted reverse-proxy hops. Keep 0 unless the backend host's
# documented network topology requires a specific numeric hop count.
TRUST_PROXY_HOPS=0
# Optional display/deployment tag. The active artifact hash is returned by Python.
# MODEL_VERSION=deployment-tag

# API
API_URL=http://localhost:5001
APP_URL=http://localhost:5173

# Database (if applicable)
# Local PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinical_insight_engine

# Supabase (hosted PostgreSQL) — set DB_SSL=true or use a *.supabase.co URL
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# DB_SSL=true

# Supabase frontend/auth environment variables
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication
SESSION_SECRET=replace-with-a-long-random-session-secret
JWT_SECRET=replace-with-a-separate-random-jwt-secret-at-least-32-characters
# Keep true in production. false is honored only when APP_URL is localhost over HTTP.
SESSION_COOKIE_SECURE=true
# HMAC key used to sign/verify the packaged model artifact; configure separately
# from session and JWT secrets in the backend environment.
MODEL_SIGNING_KEY=replace-with-a-separate-random-model-signing-key
ALLOW_DEV_MODEL_SIGNING=0

# Email (Resend) — required in production
RESEND_API_KEY=your-resend-api-key
# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (SMTP) — required in production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@clinicalinsight.dev

# Redis (async assessment queue)
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=your-elasticsearch-api-key

# Other
NODE_ENV=development
# Admin seed credentials — MUST be set in production
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Privacy / PHI Redaction
ENABLE_PHI_REDACTION=true

# ML Service Timeout & Retry Settings
REQUEST_TIMEOUT=5000
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2

